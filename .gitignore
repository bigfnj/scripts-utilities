# AI agent infrastructure - local only, not for version control
AI_UNDERSTANDING/
.codex/
# Agent worktrees land HERE, inside the repo, so each one is a full second copy of the tree.
# Without this line `git add -A` stages every file of every concurrent agent's checkout.
# Scoped to worktrees/ rather than all of .claude/ so a future tracked .claude/settings.json
# or .claude/commands/ still works.
.claude/worktrees/
**/*.aiu.json
CLAUDE.md
AGENTS.md

# Archives
*.zip

# Generated per-workstation install inventory
manifest/tools.json
logs/

# Env / secrets
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.kdbx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.age
# age/sops KEYS, not encrypted output: an .enc.yaml is meant to be committed.
keys.txt
age-key.txt

SESSION_LOG*.md
SESSION_HANDOFF*.md

.cursorrules
.windsurfrules
SESSION_*
